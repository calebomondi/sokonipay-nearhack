# Copy to .env and fill in. Never commit .env.
NEAR_NETWORK=testnet
SOKONIPAY_CONTRACT=sokonipay.testnet
SUSD_TOKEN=susd.sokonipay.testnet

# Merchant Agent function-call key (can only call create_invoice / pay_invoice / redeem)
MERCHANT_ACCOUNT_ID=
MERCHANT_AGENT_PRIVATE_KEY=

# NEAR AI Cloud (OpenAI-compatible). Leave empty to run agents in scripted mode.
NEARAI_API_KEY=
NEARAI_BASE_URL=
NEARAI_MODEL=
AGENT_MODE=scripted

# HMAC secret for rotating presence QR codes
PRESENCE_QR_SECRET=
