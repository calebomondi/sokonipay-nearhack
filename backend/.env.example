# Copy to backend/.env and fill in. Never commit backend/.env.

# Supabase: Google sign-in and Postgres (tables live in the `sokonipay` schema)
SUPABASE_BASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_DB_CONN_STR=

# Local development: use the Postgres in docker-compose.yml instead of the Supabase database.
# Leave this unset in production.
DATABASE_URL=postgresql://sokonipay:sokonipay@localhost:5433/sokonipay

# Full-access key of the contract account (sokonipay.testnet). Creates user sub-accounts,
# verifies new shops, and mints demo sUSD.
ROOT_ACCOUNT_KEY=

# Fernet key that encrypts the NEAR keys stored in Postgres:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
KEY_VAULT_SECRET=
PRESENCE_QR_SECRET=

# NEAR AI Cloud. Leave empty, or set AGENT_MODE=scripted, to run the agents without an LLM.
NEAR_AI_CLOUD_API_KEY=
AGENT_MODE=auto

ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Who may approve shops and open the admin page (comma-separated emails)
ADMIN_EMAILS=
# Hosted demo only: let a shop owner verify their own new shop (the same onchain set_verified an admin sends).
DEMO_SELF_VERIFY=false

# NEAR Intents (mainnet only). The JWT lowers the swap fee; without it quotes still work.
NEAR_INTENTS_1CLICK_JWT=
# Leave empty to keep "Add money" in preview: live quotes, no real money. Set it to the mainnet NEAR
# account that should receive real USDC, and the app offers a real deposit address as well.
INTENTS_TREASURY=

# ElevenLabs: lets people speak to their agent and hear it answer. Leave empty to hide the voice buttons.
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
